# Copy to `.env` (Docker Compose) or `.env.local` (npm run dev). Never commit real values.

# ---- App (optional) --------------------------------------------------------
# Everything runs in the browser by default — no keys required.
# Optional: GPT moment analysis / titles and the "Cloud Whisper API" option.
# The key stays on the server; the browser calls /api/ai/* which proxies to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional: OpenAI-compatible endpoint (e.g. Azure OpenAI / proxy)
OPENAI_BASE_URL=

# ---- Cloud AI protection (only matters when OPENAI_API_KEY is set) ----------
# Require visitors to enter this code before the site spends your OpenAI credit.
# Leave empty to let every visitor use cloud AI (still rate-limited and capped below).
AI_ACCESS_CODE=
# Hard daily caps for the whole site (reset at 00:00 UTC). 0 = no cap (not recommended).
AI_DAILY_TOKENS=2000000
AI_DAILY_AUDIO_MINUTES=180
# Per visitor (by IP address).
AI_RATE_PER_MINUTE=20
AI_RATE_PER_DAY=200
AI_CLIENT_DAILY_TOKENS=200000
AI_CLIENT_DAILY_AUDIO_MINUTES=60
# Max simultaneous OpenAI calls.
AI_MAX_CONCURRENT=4
# Set to true only if the site is behind Cloudflare (uses CF-Connecting-IP for the visitor's IP).
TRUST_CLOUDFLARE=false

# ---- Docker Compose deployment ----------------------------------------------
# Host port the app is published on.
PORT=3000
# 127.0.0.1 = only reachable via a reverse proxy on this server (recommended for HTTPS setups).
APP_BIND=0.0.0.0
# Image published by GitHub Actions (docker-compose.yml).
APP_IMAGE=ghcr.io/ttolaaa/clippingeditor:latest
# How often (seconds) to check for a new version.
UPDATE_INTERVAL=60

# Only if the GHCR image is private: GitHub username + token with `read:packages` (used by Watchtower).
REGISTRY_USER=
REGISTRY_TOKEN=

# Optional instant updates triggered by CI (Watchtower HTTP API).
WATCHTOWER_HTTP_API=false
WATCHTOWER_TOKEN=
WATCHTOWER_BIND=127.0.0.1
WATCHTOWER_PORT=8080

# Build-from-source deployment (docker-compose.build.yml).
DEPLOY_BRANCH=main
# Only for a private fork: GitHub token with read access to the repository.
GIT_TOKEN=